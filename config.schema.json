
{
    "pluginAlias": "EQ3Thermostat",
    "pluginType": "accessory",
    "schema": {
        "type": "object",
        "properties": {
            "name": {
                "title": "Name of the thermostat",
                "type": "string",
                "required": true,
                "default": "Office Thermostat"
            },
            "macAddress": {
                "title": "Bluetooth mac address of the thermostat",
                "type": "string",
                "required": true,
                "format": "mac"
            },
            "cacheDuration": {
                "title": "Cache duration (in seconds)",
				"type": "number",
				"required": true,
				"default": 10
            },
            "debug": {
                "title": "Extra logging",
                "description": "Log every request to the thermostat and its full response, including eq3.exp output. Use when troubleshooting.",
                "type": "boolean",
                "default": false
            }
        }
    },
    "layout": [
        {
            "type": "section",
            "items": [
                {
                    "key": "name",
                    "type": "text"
                },
                {
                    "key": "macAddress",
                    "type": "text"
                },
				{
				    "key": "cacheDuration",
				    "type": "number"
				}
            ]
        },
        {
            "type": "section",
            "title": "Advanced",
            "expandable": true,
            "expanded": false,
            "items": [
                "debug"
            ]
        }
    ]
}
